############################
# Shopify Translator (.env)
############################

# Shopify (required for live reads/writes)
SHOPIFY_STORE_DOMAIN=example-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5.6-sol

# Neon/PostgreSQL
NEON_DATABASE_URL=

# Target predefinito per CLI (puoi passarlo via flag)
SOURCE_LOCALE=en
TARGET_LOCALE=fr
TARGET_LOCALES=fr,de

# Opzioni traduttore
DO_NOT_TRANSLATE_YAML=src/config/do_not_translate.yaml
#LOG_PAYLOADS=false

# Specializzazione dominio (personalizza il prompt)
TRANSLATOR_SPECIALIZATION=e-commerce product catalog
TRANSLATOR_BRAND=
TRANSLATOR_AUDIENCE=online shoppers who expect accurate product information
SOURCE_LANGUAGE_NAME=English

# Cache locale (CLI)
TRANSLATION_CACHE_PATH=state/cache.sqlite
